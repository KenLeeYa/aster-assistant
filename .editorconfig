root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.{kt,kts}]
indent_size = 4
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.ps1]
end_of_line = crlf
indent_size = 4

[*.md]
trim_trailing_whitespace = false
