# Non-secret metadata only. Copying this file is optional.
KY_JARVIS_HOST=127.0.0.1
KY_JARVIS_PORT=8765
KY_JARVIS_TIMEZONE=Asia/Taipei
KY_JARVIS_LOCALE=zh-TW
KY_JARVIS_DEPLOYMENT_MODE=local-only
KY_JARVIS_OPERATOR_RP_ID=localhost
KY_JARVIS_OPERATOR_ORIGIN=http://localhost:3000
KY_JARVIS_ENABLE_VOICE=false
KY_JARVIS_ENABLE_WAKE_WORD=false
KY_JARVIS_ENABLE_GOOGLE_CALENDAR=false
KY_JARVIS_ENABLE_GMAIL=false
KY_JARVIS_ENABLE_GOOGLE_DRIVE=false
KY_JARVIS_ENABLE_MICROSOFT_GRAPH=false
KY_JARVIS_ENABLE_PLANE=false
KY_JARVIS_ENABLE_N8N=false
KY_JARVIS_ENABLE_LOCAL_FILES=false
KY_JARVIS_ENABLE_WINDOWS_EXECUTOR=false
KY_JARVIS_ENABLE_MEM0_ADAPTER=false
KY_JARVIS_ENABLE_CLOUD_AI=false
KY_JARVIS_ENABLE_LAN_ACCESS=false
KY_JARVIS_ENABLE_ANDROID_APP=false
KY_JARVIS_ENABLE_ANDROID_ASSISTANT_ROLE=false
KY_JARVIS_ENABLE_OPENAI_REALTIME=false
KY_JARVIS_ENABLE_REMOTE_GATEWAY=false
KY_JARVIS_ENABLE_PUSH_NOTIFICATIONS=false
